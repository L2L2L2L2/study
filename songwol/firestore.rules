rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /songwolAttendance/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /songwolMeta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /songwolPhotos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
